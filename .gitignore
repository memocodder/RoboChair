# --- Machine Learning / Reinforcement Learning ---
# Large data files (consider Git LFS for crucial datasets if needed)
# Or ignore specific subfolders or file types
data/episodes*
data/processed_datasets/*
# If your datasets are small and crucial for reproducibility, comment out the lines above

